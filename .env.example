# Postgres (Neon) — pooled connection, used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Postgres (Neon) — direct (non-pooled) connection, used by Prisma Migrate
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Neon Object Storage (S3-compatible) — resume PDFs + profile photos.
# Create the bucket with "Public" visibility so uploaded files are readable at their URL.
AWS_ENDPOINT_URL_S3="https://your-branch.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-2"
S3_BUCKET="uploads"

# Auth — generate with: openssl rand -hex 32
AUTH_JWT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OpenAI — powers resume -> structured content extraction (required for onboarding to work)
OPENAI_API_KEY=

# Admin area (/admin, login at /admin/login) — lists and can delete any portfolio
ADMIN_EMAIL=
ADMIN_PASSWORD=
